{
  "name": "aca-slack-bot",
  "version": "1.0.0",
  "description": "ACA Insurance Agency AI Support System for Slack",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npm run clean && tsc && npm run copy-static",
    "clean": "rm -rf dist",
    "copy-static": "cp -r src/database/migrations dist/database/ 2>/dev/null || :",
    "setup": "ts-node scripts/setupDatabase.ts",
    "ingest": "ts-node scripts/ingestTrainingData.ts",
    "test-bot": "ts-node scripts/testBot.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "ts-node scripts/setupDatabase.ts",
    "health-check": "node -e \"require('http').get('http://localhost:3000/health', (r) => {r.statusCode === 200 ? process.exit(0) : process.exit(1)})\"",
    "postinstall": "echo 'Dependencies installed successfully'",
    "prestart": "echo 'Starting ACA Slack Bot...'",
    "predeploy": "npm run build",
    "deploy": "npm run build && pm2 start dist/index.js --name aca-bot"
  },
  "dependencies": {
    "@slack/bolt": "^3.17.0",
    "@slack/web-api": "^6.10.0",
    "openai": "^4.20.0",
    "langchain": "^0.2.0",
    "@langchain/openai": "^0.1.0",
    "@langchain/community": "^0.2.0",
    "pg": "^8.11.3",
    "pgvector": "^0.1.5",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "node-cache": "^5.1.2",
    "uuid": "^9.0.1",
    "axios": "^1.6.2",
    "moment-timezone": "^0.5.43",
    "p-queue": "^7.4.1",
    "rate-limiter-flexible": "^3.0.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "aws-sdk": "^2.1500.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/express": "^4.17.21",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "@typescript-eslint/parser": "^6.13.1",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "nodemon": "^3.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/aca-slack-bot.git"
  },
  "keywords": [
    "slack",
    "bot",
    "ai",
    "openai",
    "gpt4",
    "insurance",
    "aca",
    "support",
    "automation"
  ],
  "author": "Your Company Name",
  "license": "PROPRIETARY",
  "bugs": {
    "url": "https://github.com/your-org/aca-slack-bot/issues"
  },
  "homepage": "https://github.com/your-org/aca-slack-bot#readme",
  "private": true
}
