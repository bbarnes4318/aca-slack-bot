# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here
SLACK_TEAM_ID=T1234567890
MANAGEMENT_CHANNEL_ID=C1234567890
SUPPORT_CHANNEL_ID=C0987654321

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-optional-org-id

# Database Configuration (Digital Ocean PostgreSQL)
DB_HOST=your-database-host.db.ondigitalocean.com
DB_PORT=25060
DB_NAME=aca_bot_production
DB_USER=doadmin
DB_PASSWORD=your-secure-password-here
DB_SSL=true
DB_POOL_SIZE=20

# Bot Configuration
BOT_NAME=ACA Support System
BOT_PERSONA=professional_helpful
RESPONSE_DELAY_MIN=500
RESPONSE_DELAY_MAX=2000
CONFIDENCE_THRESHOLD=0.7
ESCALATION_THRESHOLD=0.6

# Cache Configuration
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# Rate Limiting
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Features
ENABLE_LEARNING_MODE=true
ENABLE_FEEDBACK_COLLECTION=true
ENABLE_AUTO_ESCALATION=true
ENABLE_CACHE=true

# Node Environment
NODE_ENV=development
PORT=3000

# Digital Ocean Spaces (for training data storage on App Platform)
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key
DO_SPACES_BUCKET=aca-bot-training
DO_SPACES_REGION=nyc3

